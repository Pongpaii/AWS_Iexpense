# คัดลอกเป็น .env.local แล้วใส่ค่าจาก CDK outputs (ค่าเหล่านี้เป็น public ห้ามใส่ secret)
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-southeast-1.amazonaws.com
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=ap-southeast-1

# (ไม่บังคับ) บัญชีทดลองบนหน้า login: ผู้ใช้พิมพ์ "demo" + รหัสผ่านนี้ แอปแปลง demo → อีเมลด้านล่าง
# สร้างด้วย scripts/create-demo-user.ps1 — ค่านี้ถูกฝังใน bundle ให้ทุกคนเห็น ใช้กับบัญชีทดลองเท่านั้น
VITE_DEMO_EMAIL=demo@moneyflow.app
VITE_DEMO_PASSWORD=123456
